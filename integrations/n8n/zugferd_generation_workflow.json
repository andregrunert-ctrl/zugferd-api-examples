      "webhookId": "zugferd-generate-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://e-rechnung-cloud.de/v1/invoice/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.ZUGFERD_API_KEY || 'zg_test_ouroboros_001' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body || $json) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "invoice_pdf"
            }
          }
        }
      },
      "id": "22d73c68-e4b7-4a0b-930f-b0df576a0102",
      "name": "HTTP Request: ZUGFeRD API aufrufen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "binary",
        "responseDataSource": "firstNodeOutput",
        "dataPropertyName": "invoice_pdf",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/pdf"
              },
              {
                "name": "Content-Disposition",
                "value": "attachment; filename=\"e-rechnung.pdf\""
              }
            ]
          }
        }
      },
      "id": "33d73c68-e4b7-4a0b-930f-b0df576a0103",
      "name": "Respond: PDF zurückgeben",
