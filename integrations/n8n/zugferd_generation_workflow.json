      "id": "11d73c68-e4b7-4a0b-930f-b0df576a0101",
      "name": "Webhook: Rechnungsdaten empfangen",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
